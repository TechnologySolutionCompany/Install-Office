<UserControl x:Class="TSCBr.OfficeInstaller.Controls.BusyIndicator"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="14" Height="14" Visibility="Collapsed" Focusable="False" IsHitTestVisible="False">
  <Viewbox Stretch="Uniform">
    <Grid Width="24" Height="24">
      <Ellipse Margin="3" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}" StrokeThickness="2.5" Opacity="0.16" />
      <Path Data="M 12,3 A 9,9 0 1 1 3,12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=UserControl}}"
            StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round">
        <Path.RenderTransform><RotateTransform x:Name="SpinnerRotation" CenterX="12" CenterY="12" /></Path.RenderTransform>
      </Path>
    </Grid>
  </Viewbox>
</UserControl>
